generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  name            String?
  role            String    @default("user")
  plan            String    @default("free")
  status          String    @default("trial")
  trialEndsAt     DateTime?
  planActivatedAt DateTime?
  planExpiresAt   DateTime?
  isAdmin         Boolean   @default(false)
  totalPostsUsed  Int       @default(0)
  dailyPostsUsed  Int       @default(0)
  credits         Int       @default(0)
  passwordHash    String?
  lastActiveAt    DateTime?
   lastResetDate   DateTime  @default(now())
   resetToken      String?
   resetTokenExpiry DateTime?
   createdAt       DateTime  @default(now())
   updatedAt       DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  resetTokens    ResetToken[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  mediaJobs      MediaJob[]
  transactions   Transaction[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  lastActiveAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MediaAssetType {
  IMAGE
  VIDEO
}

enum MediaJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AestheticStyle {
  DEFAULT
  ANIMATION_3D
  ANIME
  CYBERPUNK
  CINEMATIC
  VINTAGE_VHS
}

model MediaJob {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MediaAssetType
  status          MediaJobStatus @default(QUEUED)
  prompt          String
  stylePreset     AestheticStyle @default(DEFAULT)
  anchorWeight    Float          @default(0.55)
  keepShapeWeight Float          @default(0.50)
  sourceAssetUrl  String?
  outputAssetUrl  String?
  errorLog        String?
  executionTime   Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

model Post {
  id          String   @id @default(cuid())
  content     String
  platform    String
  prompt      String?
  userId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Billing Enums ────────────────────────────────────────────────────────────


// ─── Immutable billing ledger entry per successful payment ────────────────────

model Transaction {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway      String
  status       String @default("COMPLETED")
  planId       String
  amountUSD    Float              @default(0)
  amountPi     Float?
  paymentRef   String             @unique
  creditsAdded Int                @default(0)
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([gateway])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

// ─── Idempotency table: prevents duplicate webhook processing ─────────────────

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  gateway     String
  eventType   String
  processedAt DateTime @default(now())
  metadata    Json?

  @@index([gateway])
  @@index([processedAt])
}
