# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── AUTH ─────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
# Without it the app falls back to a random per-process secret, so
# sessions break on restart and do not work across multiple instances.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=

# ── OAUTH PROVIDERS ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
X_TWITTER_CLIENT_ID=
X_TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── AI ──────────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ── ADMIN ───────────────────────────────────────────────────
# Comma-separated. REQUIRED, and the ONLY way to grant admin access --
# there are no hardcoded allowlists left in the code. Admins bypass the
# media-synthesis paid-tier gate, so every founder/operator who needs it
# must be listed here. If this is empty or unset, isAdminEmail() denies
# everyone and all /api/admin* routes return 401/403.
ADMIN_EMAILS=admin@example.com

# ── EMAIL (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@teosegypt.com

# ── RATE LIMITING ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── PAYMENTS (Dodo/Tap) ────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
TAP_WEBHOOK_SECRET=
TAP_PRO_INVOICE_LINK=
TAP_AGENCY_INVOICE_LINK=

# ── OBSERVABILITY ──────────────────────────────────────────
LOG_WEBHOOK_URL=

# ── INTERNAL ───────────────────────────────────────────────
INTERNAL_KEY=

# ── PUBLIC ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
